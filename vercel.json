{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build:shared && npm run build --workspace @agrogood/web",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://REEMPLAZA-API.up.railway.app/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://REEMPLAZA-API.up.railway.app/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
