# === Base de datos ===
# Coincide con docker-compose.yml
DATABASE_URL="postgresql://agrogood:agrogood_dev@localhost:5432/agrogood?schema=public"

# === Aplicación ===
NODE_ENV=development
PORT=3000
# Origen(es) permitido(s) para CORS (separados por coma)
CORS_ORIGIN=http://localhost:5173

# === Autenticación (JWT) ===
# Genera secretos robustos en producción: `openssl rand -base64 48`
JWT_ACCESS_SECRET=cambia-esto-en-produccion-access
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=cambia-esto-en-produccion-refresh
JWT_REFRESH_TTL=7d

# === Seguridad de cookies ===
# En producción: COOKIE_SECURE=true (requiere HTTPS)
COOKIE_SECURE=false

# === Rate limiting ===
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# === Datos demo (seed) ===
# Contraseña común de los usuarios demo generados por el seed
SEED_DEMO_PASSWORD=Agrogood.2026
