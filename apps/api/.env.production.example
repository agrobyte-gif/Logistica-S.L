# === Variables de entorno de la API en PRODUCCIÓN ===
# Configúralas en el panel del host (Railway/Render), NO subas este archivo con
# valores reales. Genera los secretos con: openssl rand -base64 48

# --- Base de datos (Neon) ---
# Primer despliegue: usa la cadena DIRECTA (sin -pooler), sirve para db push y app.
# Debe incluir sslmode=require. Ejemplo:
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/agrogood?sslmode=require"

# --- Aplicación ---
NODE_ENV=production
PORT=3000
# Origen(es) del frontend permitido(s) para CORS y WebSocket (coma-separados).
# Es tu dominio de Vercel (y el custom domain si lo tienes).
CORS_ORIGIN=https://tu-app.vercel.app

# --- Autenticación (JWT) --- (secretos robustos y distintos)
JWT_ACCESS_SECRET=REEMPLAZA_openssl_rand_base64_48
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=REEMPLAZA_otro_distinto
JWT_REFRESH_TTL=7d

# --- Cookies --- en producción SIEMPRE true (requiere HTTPS)
COOKIE_SECURE=true

# --- Rate limiting ---
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# --- Seed (solo para la carga inicial de datos demo; quítalo luego) ---
SEED_DEMO_PASSWORD=cambia-esta-clave-demo
