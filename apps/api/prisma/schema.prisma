// AGROGOOD — Esquema Prisma
// Fase 1: identidad, seguridad, multi-tenant y auditoría.
// Las entidades de dominio (CRM, ventas, inventario, etc.) se agregan por fase.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EntityStatus {
  ACTIVO
  INACTIVO
}

/// Empresa / tenant. Toda entidad operativa cuelga de aquí.
model Company {
  id             String       @id @default(uuid())
  rut            String
  razonSocial    String       @map("razon_social")
  nombreComercial String?     @map("nombre_comercial")
  giro           String?
  direccion      String?
  estado         EntityStatus @default(ACTIVO)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  users      User[]
  warehouses Warehouse[]
  roles      Role[]
  auditLogs  AuditLog[]

  // Fase 2
  customers         Customer[]
  suppliers         Supplier[]
  categories        Category[]
  products          Product[]
  priceLists        PriceList[]
  salesOrders       SalesOrder[]
  purchaseRequests  PurchaseRequest[]
  inventory         Inventory[]
  documentSequences DocumentSequence[]

  @@unique([rut])
  @@map("companies")
}

/// Bodega perteneciente a una empresa (multi-bodega desde el día uno).
model Warehouse {
  id        String       @id @default(uuid())
  companyId String       @map("company_id")
  nombre    String
  tipo      String?
  direccion String?
  estado    EntityStatus @default(ACTIVO)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  company        Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  locations      WarehouseLocation[]
  userWarehouses UserWarehouse[]
  inventory      Inventory[]
  salesOrders    SalesOrder[]

  @@index([companyId])
  @@map("warehouses")
}

/// Ubicación física dentro de una bodega (cámara, secos, rack, posición).
model WarehouseLocation {
  id          String   @id @default(uuid())
  warehouseId String   @map("warehouse_id")
  codigo      String
  tipo        String?
  descripcion String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@unique([warehouseId, codigo])
  @@map("warehouse_locations")
}

/// Usuario del sistema.
model User {
  id               String       @id @default(uuid())
  companyId        String       @map("company_id")
  nombre           String
  email            String
  passwordHash     String       @map("password_hash")
  estado           EntityStatus @default(ACTIVO)
  twoFactorSecret  String?      @map("two_factor_secret")
  twoFactorEnabled Boolean      @default(false) @map("two_factor_enabled")
  lastLoginAt      DateTime?    @map("last_login_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  company        Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  userRoles      UserRole[]
  userWarehouses UserWarehouse[]
  refreshTokens  RefreshToken[]
  passwordResets PasswordResetToken[]
  auditLogs      AuditLog[]

  // Fase 2 (vendedor asignado)
  customersVendedor    Customer[]   @relation("CustomerVendedor")
  salesOrdersVendedor  SalesOrder[] @relation("SalesOrderVendedor")

  // Email único por empresa (ver auditoría B5): un mismo correo no se repite
  // dentro de una empresa, pero podría existir en otra.
  @@unique([companyId, email])
  @@index([companyId])
  @@map("users")
}

/// Rol (RBAC). companyId nulo = rol de sistema/plantilla.
model Role {
  id          String   @id @default(uuid())
  companyId   String?  @map("company_id")
  nombre      String
  descripcion String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company         Company?         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([companyId, nombre])
  @@map("roles")
}

/// Permiso granular con formato `recurso:accion`.
model Permission {
  id          String   @id @default(uuid())
  clave       String   @unique
  descripcion String?
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Alcance por bodega: a qué bodegas puede acceder un usuario (auditoría D3).
model UserWarehouse {
  userId      String @map("user_id")
  warehouseId String @map("warehouse_id")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@id([userId, warehouseId])
  @@map("user_warehouses")
}

/// Refresh token rotatorio (se guarda hash, nunca el token en claro).
model RefreshToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  tokenHash  String    @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/// Token de recuperación de contraseña (se guarda hash).
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Bitácora de auditoría — APPEND ONLY.
/// Sin endpoints de UPDATE/DELETE (prompt §30). En producción se revoca
/// además el permiso DELETE a nivel de rol de BD de la aplicación.
model AuditLog {
  id              String   @id @default(uuid())
  companyId       String?  @map("company_id")
  userId          String?  @map("user_id")
  action          String
  entityType      String   @map("entity_type")
  entityId        String?  @map("entity_id")
  stateBefore     Json?    @map("state_before")
  stateAfter      Json?    @map("state_after")
  relatedDocument String?  @map("related_document")
  ipAddress       String?  @map("ip_address")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")

  company Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user    User?    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@index([companyId, createdAt])
  @@map("audit_logs")
}

// ==========================================================================
// Fase 2 — CRM, productos, proveedores, ventas
// ==========================================================================

enum ProductUnit {
  UN
  KG
  G
  CAJA
  SACO
  MALLA
  BANDEJA
  L
  OTRO
}

enum StockStatus {
  DISPONIBLE
  INSUFICIENTE
  SIN_STOCK
}

enum SalesOrderStatus {
  RECIBIDO
  VALIDANDO_STOCK
  CONFIRMADO
  ESPERANDO_COMPRA
  EN_PICKING
  PICKING_INCOMPLETO
  PREPARADO
  EN_DESPACHO
  EN_RUTA
  ENTREGADO
  INCIDENCIA
  CANCELADO
}

enum PurchaseRequestStatus {
  PENDIENTE
  COTIZANDO
  APROBADA
  ORDENADA
  RECHAZADA
}

enum PurchaseRequestOrigin {
  AUTO_STOCK
  MANUAL
}

/// Cliente (CRM, prompt §7).
model Customer {
  id              String       @id @default(uuid())
  companyId       String       @map("company_id")
  rut             String
  razonSocial     String       @map("razon_social")
  nombreComercial String?      @map("nombre_comercial")
  tipoCliente     String?      @map("tipo_cliente")
  condicionPago   String?      @map("condicion_pago")
  creditoHabilitado Boolean    @default(false) @map("credito_habilitado")
  limiteCredito   Decimal      @default(0) @map("limite_credito") @db.Decimal(14, 2)
  priceListId     String?      @map("price_list_id")
  vendedorId      String?      @map("vendedor_id")
  estado          EntityStatus @default(ACTIVO)
  createdById     String?      @map("created_by")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  company   Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  priceList PriceList?        @relation(fields: [priceListId], references: [id], onDelete: SetNull)
  vendedor  User?             @relation("CustomerVendedor", fields: [vendedorId], references: [id], onDelete: SetNull)
  addresses CustomerAddress[]
  contacts  CustomerContact[]
  salesOrders SalesOrder[]

  // RUT único por empresa (auditoría B5): un mismo RUT puede ser cliente en
  // otra empresa, o proveedor en la misma.
  @@unique([companyId, rut])
  @@index([companyId, estado])
  @@map("customers")
}

model CustomerAddress {
  id               String   @id @default(uuid())
  customerId       String   @map("customer_id")
  alias            String?
  direccion        String
  comuna           String?
  region           String?
  horarioRecepcion String?  @map("horario_recepcion")
  diasPedido       String?  @map("dias_pedido")
  diasDespacho     String?  @map("dias_despacho")
  esPrincipal      Boolean  @default(false) @map("es_principal")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  salesOrders SalesOrder[]

  @@index([customerId])
  @@map("customer_addresses")
}

model CustomerContact {
  id          String   @id @default(uuid())
  customerId  String   @map("customer_id")
  nombre      String
  cargo       String?
  telefono    String?
  email       String?
  esPrincipal Boolean  @default(false) @map("es_principal")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_contacts")
}

/// Proveedor (prompt §11).
model Supplier {
  id            String       @id @default(uuid())
  companyId     String       @map("company_id")
  rut           String
  razonSocial   String       @map("razon_social")
  contacto      String?
  telefono      String?
  email         String?
  condicionPago String?      @map("condicion_pago")
  estado        EntityStatus @default(ACTIVO)
  createdById   String?      @map("created_by")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  productSuppliers ProductSupplier[]
  purchaseRequests PurchaseRequest[]

  @@unique([companyId, rut])
  @@index([companyId, estado])
  @@map("suppliers")
}

/// Categoría / subcategoría de producto (auto-relación).
model Category {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  nombre    String
  parentId  String?  @map("parent_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company  Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@unique([companyId, nombre, parentId])
  @@index([companyId])
  @@map("categories")
}

/// Maestro de productos (prompt §8).
model Product {
  id              String       @id @default(uuid())
  companyId       String       @map("company_id")
  sku             String
  codigoInterno   String?      @map("codigo_interno")
  codigoBarras    String?      @map("codigo_barras")
  nombre          String
  categoryId      String?      @map("category_id")
  marca           String?
  unidadBase      ProductUnit  @default(UN) @map("unidad_base")
  peso            Decimal?     @db.Decimal(12, 3)
  volumen         Decimal?     @db.Decimal(12, 3)
  ivaAfecto       Boolean      @default(true) @map("iva_afecto")
  stockMinimo     Decimal      @default(0) @map("stock_minimo") @db.Decimal(14, 3)
  stockMaximo     Decimal?     @map("stock_maximo") @db.Decimal(14, 3)
  puntoReposicion Decimal?     @map("punto_reposicion") @db.Decimal(14, 3)
  manejaLote      Boolean      @default(false) @map("maneja_lote")
  manejaVencim    Boolean      @default(false) @map("maneja_vencimiento")
  estado          EntityStatus @default(ACTIVO)
  createdById     String?      @map("created_by")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  category         Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  prices           ProductPrice[]
  productSuppliers ProductSupplier[]
  inventory        Inventory[]
  orderItems       SalesOrderItem[]
  purchaseRequests PurchaseRequest[]

  @@unique([companyId, sku])
  @@index([companyId, estado])
  @@index([codigoBarras])
  @@map("products")
}

/// Proveedores alternativos de un producto + código de proveedor.
model ProductSupplier {
  id             String   @id @default(uuid())
  productId      String   @map("product_id")
  supplierId     String   @map("supplier_id")
  codigoProveedor String? @map("codigo_proveedor")
  precioRef      Decimal? @map("precio_ref") @db.Decimal(14, 2)
  esPrincipal    Boolean  @default(false) @map("es_principal")

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([productId, supplierId])
  @@map("product_suppliers")
}

/// Lista de precios (prompt §8).
model PriceList {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  nombre    String
  moneda    String   @default("CLP")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company   Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  prices    ProductPrice[]
  customers Customer[]

  @@unique([companyId, nombre])
  @@map("price_lists")
}

/// Precio de venta de un producto en una lista (histórico por vigencia).
model ProductPrice {
  id           String    @id @default(uuid())
  priceListId  String    @map("price_list_id")
  productId    String    @map("product_id")
  precioVenta  Decimal   @map("precio_venta") @db.Decimal(14, 2)
  vigenteDesde DateTime  @default(now()) @map("vigente_desde")
  vigenteHasta DateTime? @map("vigente_hasta")

  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([priceListId, productId])
  @@map("product_prices")
}

/// Stock por producto y bodega. Fase 2 mantiene el nivel; la Fase 3 (WMS)
/// añade ubicaciones, lotes y el libro mayor `inventory_movements`.
model Inventory {
  id                String   @id @default(uuid())
  companyId         String   @map("company_id")
  warehouseId       String   @map("warehouse_id")
  productId         String   @map("product_id")
  cantidadFisica    Decimal  @default(0) @map("cantidad_fisica") @db.Decimal(14, 3)
  cantidadReservada Decimal  @default(0) @map("cantidad_reservada") @db.Decimal(14, 3)
  cantidadBloqueada Decimal  @default(0) @map("cantidad_bloqueada") @db.Decimal(14, 3)
  updatedAt         DateTime @updatedAt @map("updated_at")

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([warehouseId, productId])
  @@index([companyId, productId])
  @@map("inventory")
}

/// Pedido de venta (prompt §9).
model SalesOrder {
  id                  String           @id @default(uuid())
  companyId           String           @map("company_id")
  numero              String
  customerId          String           @map("customer_id")
  customerAddressId   String?          @map("customer_address_id")
  warehouseId         String           @map("warehouse_id")
  vendedorId          String?          @map("vendedor_id")
  estado              SalesOrderStatus @default(RECIBIDO)
  fechaPedido         DateTime         @default(now()) @map("fecha_pedido")
  fechaDespachoProg   DateTime?        @map("fecha_despacho_programada")
  total               Decimal          @default(0) @db.Decimal(14, 2)
  notas               String?
  createdById         String?          @map("created_by")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  company          Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  customer         Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerAddress  CustomerAddress? @relation(fields: [customerAddressId], references: [id], onDelete: SetNull)
  warehouse        Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  vendedor         User?            @relation("SalesOrderVendedor", fields: [vendedorId], references: [id], onDelete: SetNull)
  items            SalesOrderItem[]
  purchaseRequests PurchaseRequest[]

  @@unique([companyId, numero])
  @@index([companyId, estado])
  @@index([customerId])
  @@map("sales_orders")
}

model SalesOrderItem {
  id                String      @id @default(uuid())
  salesOrderId      String      @map("sales_order_id")
  productId         String      @map("product_id")
  cantidad          Decimal     @db.Decimal(14, 3)
  unidad            ProductUnit @default(UN)
  precioUnitario    Decimal     @map("precio_unitario") @db.Decimal(14, 2)
  cantidadConfirmada Decimal    @default(0) @map("cantidad_confirmada") @db.Decimal(14, 3)
  estadoStock       StockStatus @default(SIN_STOCK) @map("estado_stock")

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([salesOrderId])
  @@map("sales_order_items")
}

/// Necesidad / solicitud de compra (prompt §11). En Fase 2 se generan
/// automáticamente por insuficiencia de stock; el flujo completo es Fase 3.
model PurchaseRequest {
  id           String                @id @default(uuid())
  companyId    String                @map("company_id")
  origen       PurchaseRequestOrigin @default(AUTO_STOCK)
  productId    String                @map("product_id")
  cantidad     Decimal               @db.Decimal(14, 3)
  salesOrderId String?               @map("sales_order_id")
  supplierId   String?               @map("supplier_id")
  estado       PurchaseRequestStatus @default(PENDIENTE)
  solicitadoPor String?              @map("solicitado_por")
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  product    Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  salesOrder SalesOrder? @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  supplier   Supplier?   @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([companyId, estado])
  @@index([productId])
  @@map("purchase_requests")
}

/// Secuencia atómica para numerar documentos por empresa/tipo/año
/// (auditoría B3: evita folios duplicados bajo concurrencia).
model DocumentSequence {
  id        String @id @default(uuid())
  companyId String @map("company_id")
  tipo      String
  anio      Int
  ultimo    Int    @default(0)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, tipo, anio])
  @@map("document_sequences")
}
