{
  "expo": {
    "name": "AGROGOOD Operaciones",
    "slug": "agrogood-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "agrogood",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#16a34a"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "cl.agrogood.mobile"
    },
    "android": {
      "package": "cl.agrogood.mobile"
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "extra": {
      "apiBaseUrl": "http://192.168.1.100:3000/api"
    }
  }
}
